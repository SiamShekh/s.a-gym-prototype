<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SAGym" parent="Theme.Material3.Dark.NoActionBar">
        <item name="fontFamily">@font/exo_2</item>
        <item name="android:fontFamily">@font/exo_2</item>

        <item name="colorPrimary">@color/red</item>
        <item name="colorPrimaryContainer">@color/red_15</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOutline">@color/white_12</item>

        <item name="android:windowBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white_60</item>
        <item name="android:textViewStyle">@style/SAGym.TextView</item>
        <item name="buttonStyle">@style/SAGym.Button.Primary</item>
        <item name="materialButtonStyle">@style/SAGym.Button.Primary</item>
        <item name="editTextStyle">@style/SAGym.EditText</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="SAGym.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/exo_2</item>
        <item name="fontFamily">@font/exo_2</item>
    </style>

    <style name="SAGym.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="SAGym.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/exo_2</item>
        <item name="fontFamily">@font/exo_2</item>
        <item name="backgroundTint">@color/red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SAGym.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/exo_2</item>
        <item name="fontFamily">@font/exo_2</item>
        <item name="strokeColor">@color/white_20</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SAGym.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/exo_2</item>
        <item name="fontFamily">@font/exo_2</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white_40</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SAGym.EditText.Sheet" parent="SAGym.EditText">
        <item name="android:background">@drawable/bg_sheet_input</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHint">@color/white_40</item>
    </style>

    <style name="ThemeOverlay.SAGym.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SAGym.ModalBottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
    </style>

    <style name="SAGym.ModalBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/SAGym.Shape.BottomSheet</item>
    </style>

    <style name="SAGym.Shape.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
