PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

MONGODB_URI=mongodb://127.0.0.1:27017/sa-gym
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

SEED_ADMIN_PHONE=01746933966
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_NAME=Owner
GYM_PHONE=01746933966

# SMS Gateway BD — https://app.smsgatewaybd.com/api
SMS_ENABLED=false
SMS_API_URL=https://api.smsgateway.com.bd/api/send-message
SMS_CLIENT_ID=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_MAX_CHARS=70
SMS_TZ=Asia/Dhaka
# 5 = Friday (JS weekday). Comma-separated to skip more days.
SMS_SKIP_WEEKDAYS=5
# Max SMS per member per expiry cycle (anti-spam)
SMS_MAX_PER_CYCLE=3
# Daily budget guard
SMS_DAILY_MAX=200

# Railway cron: POST /api/notifications/cron with header X-Cron-Secret
CRON_SECRET=change-me-cron-secret
