<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SAGymFilterPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:fontFamily">@font/exo_2</item>
        <item name="fontFamily">@font/exo_2</item>
        <item name="android:textColor">@color/white_60</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SAGymPayMethod">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:background">@drawable/bg_pay_method</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">14dp</item>
        <item name="android:fontFamily">@font/exo_2</item>
        <item name="fontFamily">@font/exo_2</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
