# Local: Vite proxies browser /api → this origin
VITE_API_PROXY_TARGET=http://localhost:4000

# Local / same-origin (API serves the SPA): leave unset or use /api
# VITE_API_URL=/api

# Split Railway deploy (static frontend + separate API service):
# set this on the FRONTEND service as a build-time variable, then redeploy.
# Example: VITE_API_URL=https://YOUR-API.up.railway.app/api
# VITE_API_URL=
